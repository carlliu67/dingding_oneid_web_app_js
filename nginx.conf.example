# /usr/local/nginx-docker/conf/nginx.conf
# 示例配置文件，请根据实际环境修改节点地址
# 说明：前端和后端复用同一个端口（默认 7000），后端服务同时托管前端静态文件，
#       因此 nginx 只需监听一个端口并转发到应用集群即可。
user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    keepalive_timeout  65;

    # ========== 应用集群：前后端同端口服务（默认 7000） ==========
    upstream wemeet_dingding_app_cluster {
        # 替换为应用服务实际节点地址（IP:端口 / Docker容器名:端口）
        server 192.168.1.101:7000 weight=1 max_fails=3 fail_timeout=10s;
        # server 192.168.1.102:7000 weight=1 max_fails=3 fail_timeout=10s;
        # 可选策略：ip_hash（保证同一客户端访问同一节点）
    }

    include /etc/nginx/conf.d/*.conf;

    # ========== Server块：监听 7000 端口，转发给应用集群 ==========
    server {
        listen       7000;
        server_name  localhost;

        access_log  /var/log/nginx/app.access.log  main;
        error_log   /var/log/nginx/app.error.log  warn;

        # WebSocket endpoint for DingTalk H5 remote debugging
        location /ws {
            proxy_pass http://wemeet_dingding_app_cluster;

            # WebSocket specific headers
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host:$server_port;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # WebSocket timeout configuration
            proxy_connect_timeout 7d;
            proxy_read_timeout 7d;
            proxy_send_timeout 7d;
        }

        # 所有请求（含 /api 与前端静态资源）都转发给同端口应用集群
        location / {
            proxy_pass http://wemeet_dingding_app_cluster;

            # 必要代理头
            proxy_set_header Host $host:$server_port; # 保留端口信息
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # 超时配置
            proxy_connect_timeout 30s;
            proxy_read_timeout 60s;
        }

        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   /usr/share/nginx/html;
        }
    }
}
